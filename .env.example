# MongoDB Configuration
# Replace <db_password> and optionally set a database name (e.g. /hotel_management)
MONGODB_URI=mongodb+srv://mohammedemad618_db_user:<db_password>@hotel-cluster.idozp9a.mongodb.net/hotel_management?appName=hotel-cluster

# JWT Configuration
JWT_SECRET=change-me-please-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# App Configuration
# Use your deployed URL on Netlify in production
NEXT_PUBLIC_APP_URL=https://your-site-name.netlify.app
NODE_ENV=production
# Optional: comma-separated HTTPS image domains allowed by Next.js + CSP
# Example: NEXT_IMAGE_ALLOWED_DOMAINS=cdn.example.com,images.example.com
NEXT_IMAGE_ALLOWED_DOMAINS=

# Internal Cron (daily subscription maintenance + notifications)
# Must be a long random value (>=16 chars) and set in both app + Netlify environment.
INTERNAL_CRON_SECRET=change-me-with-a-long-random-secret

# Optional distributed rate limit store (recommended for production multi-instance/serverless)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Super Admin (for initial setup)
SUPER_ADMIN_EMAIL=admin@hms.com
SUPER_ADMIN_PASSWORD=ChangeThisPassword123!
